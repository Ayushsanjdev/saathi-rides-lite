# Copy to .env for an external database. npm run dev supplies a persistent local replica set otherwise.
MONGODB_URI=mongodb://127.0.0.1:27017/saathi?replicaSet=rs0&directConnection=true
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://127.0.0.1:3000
API_INTERNAL_URL=http://127.0.0.1:4000
API_PORT=4000
NODE_ENV=development
TRUST_PROXY=0
# Optional one-click demo passenger accounts; never grants driver/operator access.
DEMO_SIGN_IN=false
# Only enable demo seed for an explicitly isolated non-production database.
ALLOW_DEMO_SEED=true
DEMO_PASSWORD=replace-with-your-own-demo-password
SUPPORT_PHONE=
