{
  "name": "saathi-rides",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx scripts/local.ts",
    "dev:external": "concurrently -k \"npm run dev -w @saathi/api\" \"npm run dev -w @saathi/web\"",
    "build": "npm run build -w @saathi/api && npm run build -w @saathi/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e.ts",
    "seed": "tsx scripts/seed.ts",
    "start": "concurrently -k \"npm run start -w @saathi/api\" \"npm run start -w @saathi/web\"",
    "provision:operator": "tsx apps/api/src/provision-operator.ts",
    "dev:mobile": "tsx scripts/local.ts --mobile",
    "mobile": "npm run dev -w @saathi/mobile",
    "mobile:android": "npm run android -w @saathi/mobile",
    "mobile:ios": "npm run ios -w @saathi/mobile",
    "test:mobile": "npm run test -w @saathi/mobile",
    "build:mobile": "npm run export -w @saathi/mobile"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.5",
    "dotenv": "18.0.5",
    "mongodb": "^7.5.0",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-native-gesture-handler": "2.32.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "shell-quote": "1.12.0"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
