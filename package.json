{
  "name": "saathi-rides",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/local.ts",
    "dev:external": "concurrently -k \"pnpm --filter @saathi/api dev\" \"pnpm --filter @saathi/web dev\"",
    "build": "pnpm --filter @saathi/api build && pnpm --filter @saathi/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e.ts",
    "seed": "tsx scripts/seed.ts",
    "start": "concurrently -k \"pnpm --filter @saathi/api start\" \"pnpm --filter @saathi/web start\"",
    "provision:operator": "tsx apps/api/src/provision-operator.ts",
    "dev:mobile": "tsx scripts/local.ts --mobile",
    "mobile": "pnpm --filter @saathi/mobile dev",
    "mobile:android": "pnpm --filter @saathi/mobile android",
    "mobile:ios": "pnpm --filter @saathi/mobile ios",
    "test:mobile": "pnpm --filter @saathi/mobile test",
    "build:mobile": "pnpm --filter @saathi/mobile export"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.5",
    "dotenv": "18.0.5",
    "mongodb": "7.5.0",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.24.0"
  }
}
